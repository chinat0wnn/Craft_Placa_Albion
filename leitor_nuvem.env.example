# URL do servidor Albion Craft na AWS (sem a barra final "/")
# Exemplos:
# SERVER_URL=http://54.233.120.45:8765
# SERVER_URL=https://craft.meudominio.com
SERVER_URL=http://SEU_IP_AWS_AQUI:8765

# Token de autenticação (caso tenha configurado AUTH_TOKEN no servidor)
# Deixe vazio se não configurou token no servidor
AUTH_TOKEN=
