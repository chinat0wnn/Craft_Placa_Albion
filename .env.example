# Porta que sera exposta no servidor AWS (ex: 80 para acesso web direto, ou 8765)
HOST_PORT=8765

# Token de seguranca opcional para proteger gravacoes (/api/state e /api/ingest)
# Se preenchido, o leitor de pacotes local devera enviar este mesmo token.
# Deixe em branco se quiser acesso livre sem autenticacao.
AUTH_TOKEN=
